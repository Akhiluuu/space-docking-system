<?xml version="1.0" encoding="UTF-8"?>
<Scenario name="offcenter_docking_new">
    <Simulation>
        <duration>5.0</duration>
        <timestep>0.002</timestep>
    </Simulation>
    <PlatformParameters>
        <mass>50.0</mass>
        <inertia>
            <Ixx>5.0</Ixx>
            <Iyy>5.0</Iyy>
            <Izz>10.0</Izz>
        </inertia>
    </PlatformParameters>
    <Events>
        <!-- Initial misalignment caused by asymmetric start forces -->
        <Contact time="0.1">
            <Force fx="10.0" fy="-5.0" fz="50.0" sensor="1"/>
            <Force fx="0.0" fy="0.0" fz="10.0" sensor="2"/>
            <Force fx="0.0" fy="0.0" fz="10.0" sensor="3"/>
            <Force fx="-10.0" fy="5.0" fz="80.0" sensor="4"/>
            <Force fx="0.0" fy="0.0" fz="10.0" sensor="5"/>
            <Force fx="0.0" fy="0.0" fz="10.0" sensor="6"/>
        </Contact>
        <!-- Sustained off-center push leading to rotation/tilt -->
        <Contact time="1.0">
            <Force fx="40.0" fy="20.0" fz="150.0" sensor="4"/>
            <Force fx="0.0"  fy="0.0"  fz="10.0"  sensor="1"/>
            <Force fx="0.0"  fy="0.0"  fz="110.0" sensor="5"/>
        </Contact>
        <!-- Random noise to keep it unstable -->
        <Contact time="2.5">
            <Force fx="-50.0" fy="30.0" fz="100.0" sensor="3"/>
            <Force fx="20.0"  fy="0.0"  fz="180.0" sensor="6"/>
        </Contact>
    </Events>
</Scenario>
