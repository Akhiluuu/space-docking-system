<?xml version="1.0" encoding="UTF-8"?>
<Scenario name="off_center_contact">
    <Simulation>
        <duration>5.0</duration>
        <timestep>0.002</timestep>
    </Simulation>
    <PlatformParameters>
        <mass>50.0</mass>
        <inertia>
            <Ixx>5.0</Ixx>
            <Iyy>5.0</Iyy>
            <Izz>10.0</Izz>
        </inertia>
    </PlatformParameters>
    <Events>
        <!-- Off-center contact at 1 second - asymmetric forces cause rotation (CANNOT DOCK) -->
        <!-- Continued asymmetric contact at 2 seconds -->
        <Contact time="1">
            <Force fx="0" fy="0" fz="10" sensor="1"/>
            <Force fx="0" fy="0" fz="10" sensor="2"/>
            <Force fx="0" fy="1.9000003" fz="10" sensor="3"/>
            <Force fx="1.8000003" fy="1.7000003" fz="3" sensor="4"/>
            <Force fx="0" fy="0" fz="3" sensor="5"/>
            <Force fx="0" fy="0" fz="3" sensor="6"/>
        </Contact>
        <Contact time="2">
            <Force fx="0" fy="0" fz="8" sensor="1"/>
            <Force fx="0" fy="0" fz="8" sensor="2"/>
            <Force fx="0" fy="0" fz="8" sensor="3"/>
            <Force fx="0" fy="0" fz="2.5" sensor="4"/>
            <Force fx="0" fy="0" fz="2.5" sensor="5"/>
            <Force fx="0" fy="0" fz="2.5" sensor="6"/>
        </Contact>
    </Events>
</Scenario>
